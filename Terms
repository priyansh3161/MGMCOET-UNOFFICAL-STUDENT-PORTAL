<script>
(function(){
    var hd=document.querySelector('.bar'), prog=document.getElementById('prog'), fab=document.getElementById('fab'),
        jump=document.querySelector('.jump'), chips=[].slice.call(jump.querySelectorAll('a')), ticking=false, root=document.documentElement;
    function pad(){ root.style.scrollPaddingTop=(hd.offsetHeight+10)+'px'; }
    function upd(){
        var max=root.scrollHeight-window.innerHeight, y=window.scrollY||root.scrollTop;
        prog.style.transform='scaleX('+(max>0?Math.min(1,y/max):0)+')';
        fab.classList.toggle('show',y>700); ticking=false;
    }
    addEventListener('scroll',function(){ if(!ticking){ ticking=true; requestAnimationFrame(upd);} },{passive:true});
    addEventListener('resize',pad); pad(); upd();
    fab.addEventListener('click',function(){ scrollTo({top:0,behavior:'smooth'}); });
    if('IntersectionObserver' in window){
        var map={}; chips.forEach(function(a){ map[a.getAttribute('href').slice(1)]=a; });
        var io=new IntersectionObserver(function(es){
            es.forEach(function(e){
                if(!e.isIntersecting) return;
                chips.forEach(function(c){ c.classList.remove('on'); });
                var a=map[e.target.id]; if(!a) return;
                a.classList.add('on');
                jump.scrollTo({left:a.offsetLeft-(jump.clientWidth-a.offsetWidth)/2,behavior:'smooth'});
            });
        },{rootMargin:'-20% 0px -70% 0px'});
        document.querySelectorAll('h3[id^="tc-s"]').forEach(function(h){ io.observe(h); });
    }
})();
